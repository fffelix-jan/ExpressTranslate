<Window x:Class="ExpressTranslateWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ExpressTranslateWPF"
        mc:Ignorable="d"
        Title="Express Chinese Translator" Height="525" Width="738"
        MinHeight="400" MinWidth="600"
        ResizeMode="CanResize"
        FontFamily="Segoe UI" FontSize="13">

    <Window.InputBindings>
        <!-- Ctrl+T for Translate -->
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding TranslateCommand}"/>
        <!-- Ctrl+Shift+R for Speak Input -->
        <KeyBinding Key="R" Modifiers="Control+Shift" Command="{Binding SpeakInputCommand}"/>
        <!-- Ctrl+R for Speak Result -->
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding SpeakResultCommand}"/>
    </Window.InputBindings>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Menu -->
        <Menu Grid.Row="0" Background="White">
            <MenuItem Header="File">
                <MenuItem Header="Translate" InputGestureText="Ctrl+T" Click="TranslateMenuItem_Click"/>
                <MenuItem Header="Speak">
                    <MenuItem Header="Speak Input" InputGestureText="Ctrl+Shift+R" Click="SpeakInputMenuItem_Click"/>
                    <MenuItem Header="Speak Result" InputGestureText="Ctrl+R" Click="SpeakResultMenuItem_Click"/>
                </MenuItem>
                <MenuItem Header="Clear" Click="ClearMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="Exit" InputGestureText="Alt+F4" Click="ExitMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="About" Click="AboutMenuItem_Click"/>
            </MenuItem>
        </Menu>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="10,5,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="100"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="100"/>
            </Grid.RowDefinitions>

            <!-- Title Label -->
            <Label Grid.Row="0" Content="Express Chinese Translator" 
                   FontSize="21" FontWeight="Bold" 
                   Margin="0,5,0,5"/>

            <!-- Input TextBox -->
            <TextBox Grid.Row="1" x:Name="userInputBox" 
                     Margin="0,0,0,5"
                     TextWrapping="Wrap" 
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"/>

            <!-- Control Panel -->
            <Grid Grid.Row="2" Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0" x:Name="modeBox" 
                          Height="25" Width="144" VerticalAlignment="Center"/>

                <Button Grid.Column="1" x:Name="translateButton" 
                        Content="Translate" Height="25" Width="92" Margin="5,0,0,0"
                        Click="TranslateButton_Click"/>

                <Button Grid.Column="2" x:Name="clearButton" 
                        Content="Clear" Height="25" Width="92" Margin="5,0,0,0"
                        Click="ClearButton_Click"/>

                <!-- Spacer column (Grid.Column="3") takes up remaining space -->

                <Button Grid.Column="4" x:Name="speakInputButton" 
                        Content="Speak Input" Height="25" Width="91" Margin="5,0,0,0"
                        Click="SpeakInputButton_Click"/>

                <Button Grid.Column="5" x:Name="speakResultButton" 
                        Content="Speak Result" Height="25" Width="104" Margin="5,0,0,0"
                        Click="SpeakResultButton_Click"/>

                <Button Grid.Column="6" x:Name="copyButton" 
                        Content="Copy Translation" Height="25" Width="123" Margin="5,0,0,0"
                        Click="CopyButton_Click"/>
            </Grid>

            <!-- Output TextBox -->
            <TextBox Grid.Row="3" x:Name="userOutputBox" 
                     Margin="0,5,0,0"
                     TextWrapping="Wrap" 
                     IsReadOnly="True"
                     Background="WhiteSmoke"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"/>
        </Grid>
    </Grid>
</Window>